NODE_ENV=development
API_PORT=5000
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=change-this-local-development-secret
JWT_EXPIRES_IN=7d

# Use either DATABASE_URL or the individual PG* variables below.
# DATABASE_URL=postgres://postgres:password@localhost:5432/oop_pedagogical_hub
PGHOST=localhost
PGPORT=5432
PGDATABASE=oop_pedagogical_hub
PGUSER=postgres
PGPASSWORD=
